# Maintainer: Danny S <48356907+DannyS124@users.noreply.github.com>
pkgname=diskforge
pkgver=0.4.1
pkgrel=1
pkgdesc='Disk manager and partition editor with a Windows-style layout, built on UDisks2'
arch=('x86_64')
url='https://github.com/DannyS124/diskforge'
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-svg' 'udisks2')
makedepends=('cmake')
conflicts=('disk-manager')
replaces=('disk-manager')
optdepends=(
  'exfatprogs: create exFAT volumes'
  'dosfstools: create FAT32 volumes'
  'ntfs-3g: create NTFS volumes'
  'btrfs-progs: create Btrfs volumes'
  'xfsprogs: create XFS volumes'
)
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('448605965b44f8b699c8897f2b9869313f01800f6ba78eb08c78930901ed6948')

build() {
  cmake -S "$pkgname-$pkgver" -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DDISKFORGE_SELFTEST=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}

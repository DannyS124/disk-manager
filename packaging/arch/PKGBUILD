# Maintainer: Danny S <48356907+DannyS124@users.noreply.github.com>
pkgname=diskforge
pkgver=0.6.0
pkgrel=1
pkgdesc='Disk manager for Linux that works like Windows Disk Management'
arch=('x86_64')
url='https://github.com/DannyS124/diskforge'
license=('GPL-3.0-or-later')
depends=('glibc' 'hicolor-icon-theme' 'libgcc' 'libstdc++' 'qt6-base' 'qt6-svg' 'udisks2' 'zstd')
makedepends=('cmake' 'qt6-tools')
optdepends=(
  'exfatprogs: create exFAT volumes'
  'dosfstools: create FAT32 volumes'
  'ntfs-3g: create NTFS volumes'
  'btrfs-progs: create Btrfs volumes'
  'xfsprogs: create XFS volumes'
  'pacman-contrib: clean up the package cache in Disk Cleanup'
  'snapper: list Btrfs snapshots'
)
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('54c3c271e2158332847af64b6dbb658f5232fd8040aeb4a06db532ac0d37dd75')

build() {
  rm -rf build  # makepkg keeps src/ between builds; an old cache breaks updates
  cmake -S "$pkgname-$pkgver" -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DDISKFORGE_SELFTEST=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}

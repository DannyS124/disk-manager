<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.DannyS124.DiskForge</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>DiskForge</name>
  <summary>Disk manager and partition editor</summary>
  <developer id="io.github.dannys124">
    <name>Danny S</name>
  </developer>

  <description>
    <p>A disk manager for Linux that looks and works like Windows Disk Management.</p>
    <ul>
      <li>Mount and unmount drives</li>
      <li>Format as ext4, btrfs, NTFS, FAT32 or exFAT</li>
      <li>Create, delete and resize partitions</li>
      <li>Rename volumes and make new partition tables</li>
    </ul>
    <p>It doesn't run as root, and the drive your system is on is locked so you can't format it by accident.</p>
  </description>

  <launchable type="desktop-id">io.github.DannyS124.DiskForge.desktop</launchable>
  <provides>
    <binary>diskforge</binary>
  </provides>

  <url type="homepage">https://github.com/DannyS124/diskforge</url>
  <url type="bugtracker">https://github.com/DannyS124/diskforge/issues</url>
  <url type="vcs-browser">https://github.com/DannyS124/diskforge</url>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/DannyS124/diskforge/v@PROJECT_VERSION@/docs/screenshot.png</image>
      <caption>Main window</caption>
    </screenshot>
  </screenshots>

  <categories>
    <category>System</category>
    <category>Filesystem</category>
  </categories>
  <keywords>
    <keyword>disk</keyword>
    <keyword>partition</keyword>
    <keyword>format</keyword>
    <keyword>resize</keyword>
    <keyword>usb</keyword>
  </keywords>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.6.0" date="2026-10-08">
      <description>
        <p>Clone drives, back up and restore, rescue a failing drive, a map of bad and slow areas, disk usage,
        disk cleanup, TRIM, Btrfs snapshots, secure erase and an add-on list. Also everything from the
        unreleased 0.5.0: disk health, writing images to USB, encrypted drives, wipe, check and repair, mount
        at startup, safely remove, disk images, benchmark and add-ons.</p>
      </description>
    </release>
    <release version="0.4.3" date="2026-10-08">
      <description>
        <p>Simpler wording, and Check for Updates handles there being no release.</p>
      </description>
    </release>
    <release version="0.4.2" date="2026-10-08">
      <description>
        <p>Simpler wording in the help and About window.</p>
      </description>
    </release>
    <release version="0.4.1" date="2026-10-08">
      <description>
        <p>License changed from MIT to GPL-3.0-or-later.</p>
      </description>
    </release>
    <release version="0.4.0" date="2026-10-08">
      <description>
        <p>About dialog, app icon, AppStream metadata and a man page.</p>
      </description>
    </release>
    <release version="0.3.0" date="2026-10-08">
      <description>
        <p>Shrink and grow partitions (ext4, Btrfs, NTFS, FAT32).</p>
      </description>
    </release>
  </releases>
</component>
